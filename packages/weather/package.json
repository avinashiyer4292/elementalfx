{
  "name": "@elementalfx/weather",
  "version": "0.1.0",
  "description": "Rain, snow, fog, lightning, falling leaves and embers for any page, all driven by one shared wind field. Snow settles on your elements.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/*.global.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./global": "./dist/weather.global.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/weather.global.js",
  "jsdelivr": "./dist/weather.global.js",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "weather",
    "snow",
    "rain",
    "fog",
    "lightning",
    "particles",
    "wind",
    "webgl",
    "web-component",
    "animation",
    "christmas"
  ],
  "homepage": "https://github.com/avinashiyer4292/elementalfx/tree/main/packages/weather#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avinashiyer4292/elementalfx.git",
    "directory": "packages/weather"
  },
  "bugs": {
    "url": "https://github.com/avinashiyer4292/elementalfx/issues"
  },
  "dependencies": {
    "@elementalfx/core": "workspace:^",
    "@elementalfx/gl": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "elementalfx": {
    "global": "weather",
    "globalEntry": "src/global.ts",
    "sizeLimit": 16384
  }
}
